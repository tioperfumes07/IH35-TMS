+import { activeSettlementLine, liveBill, liveSettlement } from "../accounting/live-document-predicates.sql.js";
 
 /** A live, unpaid settlement is a cash obligation once finalized or scheduled.
  * Date bucketing is separate; all forecast views use this same eligibility rule.
@@ -42,3 +42,45 @@ export function driverApBillCarriedBySettlementSql(billAlias: string): string {
        AND (cds.status IN ('locked', 'final', 'approved', 'posted', 'closed')
             OR COALESCE(cds.payment_state, 'unpaid') <> 'unpaid')))`;
 }
+
+/**
+ * LEAD 11-03 E8 (row 261) — PROJECTED EXPENSES BY DAY for Actual vs Projected. The same three obligation classes the
+ * daily engine (getDailyPrediction) lists — driver pay (settlements), bills due, manual adjustments — summed per day,
+ * as SCHEDULED: an obligation projected for a day stays projected for that day after it is paid (projection is what
+ * was expected, the bank is what happened). The old AvP read accounting.bills only, and every driver bill inside a
+ * closed settlement is (correctly) excluded there, so measured on USMCA October 2026: 3 vendor bills, $743.25, against
+ * 29 settlements / $43,023.50 of driver pay that the engine projects — the screen showed $0.00 on almost every day.
+ *   $1 operating_company_id · $2 from · $3 to  →  rows (projected_date text, projected_expense_cents bigint)
+ * Settlement date bucket = the engine's: COALESCE(bank_settle_date, payment_sent_at, payment_queued_at, period_end).
+ * Eligibility on a PAST day cannot use the engine's unpaid filter (a paid settlement would vanish from its own day), so
+ * it is: live settlement, net_pay > 0, status past draft (locked/final/approved/posted/closed) or payment started.
+ */
+export function cashFlowProjectedExpensesByDaySql(): string {
+  const live = liveSettlement("s");
+  return `
+    SELECT projected_date::text AS projected_date, SUM(cents)::bigint AS projected_expense_cents
+      FROM (
+        SELECT COALESCE(s.bank_settle_date, s.payment_sent_at::date, s.payment_queued_at::date, s.period_end) AS projected_date,
+               ROUND(COALESCE(s.net_pay, 0) * 100)::bigint AS cents
+          FROM driver_finance.driver_settlements s
+         WHERE s.operating_company_id = $1::uuid
+           AND ${live}
+           AND COALESCE(s.net_pay, 0) > 0
+           AND (s.status IN ('locked', 'final', 'approved', 'posted', 'closed')
+                OR COALESCE(s.payment_state, 'unpaid') <> 'unpaid')
+        UNION ALL
+        SELECT b.due_date::date, COALESCE(b.amount_cents, 0)::bigint
+          FROM accounting.bills b
+         WHERE b.operating_company_id = $1::uuid
+           AND ${liveBill("b")}
+           AND NOT ${driverApBillCarriedBySettlementSql("b")}
+        UNION ALL
+        SELECT a.entry_date, a.amount_cents::bigint
+          FROM accounting.cash_flow_adjustments a
+         WHERE a.operating_company_id = $1::uuid
+           AND a.archived_at IS NULL
+      ) obligations
+     WHERE projected_date BETWEEN $2::date AND $3::date
+     GROUP BY projected_date
+     ORDER BY projected_date`;
+}
