@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import { cashFlowProjectedExpensesByDaySql } from "../cash-flow-obligations.sql.js";
+
+// LEAD 11-03 E8 (row 261): Actual vs Projected read bills only → $0.00 projected expense on almost every day.
+// Measured USMCA Oct 2026: this query = 18 days / $63,619.90 (29 settlements $43,023.50 + bills + adjustments).
+describe("cashFlowProjectedExpensesByDaySql — every obligation class the daily engine projects", () => {
+  const sql = cashFlowProjectedExpensesByDaySql();
+
+  it("sums driver pay (settlements), bills due and manual adjustments", () => {
+    expect(sql).toContain("FROM driver_finance.driver_settlements s");
+    expect(sql).toContain("FROM accounting.bills b");
+    expect(sql).toContain("FROM accounting.cash_flow_adjustments a");
+  });
+
+  it("buckets a settlement on the engine's date and counts it ONCE (its driver A/P bills are excluded)", () => {
+    expect(sql).toContain("COALESCE(s.bank_settle_date, s.payment_sent_at::date, s.payment_queued_at::date, s.period_end)");
+    expect(sql).toContain("cdb.accrued_bill_id = b.id");
+  });
+
+  it("a PAID settlement stays projected on its day (no unpaid filter) — projection is what was expected", () => {
+    expect(sql).not.toMatch(/NOT IN \('cleared', 'manual_paid', 'bounced'\)/);
+    expect(sql).toContain("s.voided_at IS NULL");
+  });
+
+  it("is scoped to one company and the requested window", () => {
+    expect(sql).toContain("s.operating_company_id = $1::uuid");
+    expect(sql).toContain("b.operating_company_id = $1::uuid");
+    expect(sql).toContain("a.operating_company_id = $1::uuid");
+    expect(sql).toContain("projected_date BETWEEN $2::date AND $3::date");
+  });
+});
