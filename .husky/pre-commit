#!/usr/bin/env sh
# Pre-commit hook: spec drift reminder for IH35-TMS
#
# Reminds Cursor (and human committers) when frontend module files change
# but the architectural design was not updated in the same commit.
#
# This is a REMINDER, not a hard block. The hard block lives in CI
# (verify:arch-design). This hook catches drift earlier, before push.

# MERGE_DRIVERS_ALWAYS_ON (HARD — Cursor conflict class 2026-07-29)
# Cursor agents often `git clone --depth` / worktree without `npm install`, so package.json
# "prepare" never runs setup-git-merge-drivers.mjs → CLAIMED-NUMBERS + module-completion JSON
# conflict on every rebase while Claude (installs / fewer hotfiles) stays clean. Register here
# every commit so merge=json-union always works in this clone.
if command -v node >/dev/null 2>&1 && [ -f scripts/setup-git-merge-drivers.mjs ]; then
  node scripts/setup-git-merge-drivers.mjs >/dev/null 2>&1 || true
fi

CHANGED_FILES=$(git diff --cached --name-only)

# Migration rename/edit guard (HARD BLOCK — GAP-MIGRATION-RENAME-CI-GUARD)
#
# Rejects commits that rename or edit content of already-applied migrations.
# Applied migrations are tracked in .applied-migrations.json.
# CI (migration-guard.yml) is authoritative; this hook provides earlier feedback.
STAGED_MIGRATIONS=$(echo "$CHANGED_FILES" | grep -E "^db/migrations/[0-9].*\.sql$" || true)
if [ -n "$STAGED_MIGRATIONS" ] && [ -f ".applied-migrations.json" ] && command -v node >/dev/null 2>&1; then
  VIOLATIONS=$(node -e "
    const fs = require('fs');
    const path = require('path');
    const crypto = require('crypto');
    const raw = JSON.parse(fs.readFileSync('.applied-migrations.json', 'utf8'));
    const entries = Array.isArray(raw) ? raw : (raw.migrations || raw.entries || []);
    const applied = new Map(entries.map(e => [e.filename || e.name, e.checksum || e.sha256 || null]));
    const staged = \`$STAGED_MIGRATIONS\`.trim().split('\n').filter(Boolean).map(f => path.basename(f));
    const violations = [];
    for (const file of staged) {
      if (!applied.has(file)) continue;
      const diskPath = path.join('db/migrations', file);
      if (!fs.existsSync(diskPath)) { violations.push('MISSING: ' + file); continue; }
      const expected = applied.get(file);
      if (expected) {
        const actual = crypto.createHash('sha256').update(fs.readFileSync(diskPath, 'utf8'), 'utf8').digest('hex');
        if (actual !== expected) violations.push('CONTENT EDITED: ' + file);
      } else {
        violations.push('STAGED APPLIED MIGRATION: ' + file);
      }
    }
    if (violations.length > 0) { console.error(violations.join('\n')); process.exit(1); }
  " 2>&1)
  MIG_GUARD_EXIT=$?
  if [ "$MIG_GUARD_EXIT" -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED by migration-rename-ci-guard:"
    echo "$VIOLATIONS"
    echo ""
    echo "Applied migrations are immutable. Create a new migration file instead."
    exit 1
  fi
fi

if echo "$CHANGED_FILES" | grep -qE "apps/frontend/src/pages/(safety|maintenance|dispatch|drivers|customers|banking|fuel|accounting|home|docs|lists|reports|form425c|vendors)/.*\.(tsx|ts)$"; then
  if ! echo "$CHANGED_FILES" | grep -q "docs/specs/IH35_ARCHITECTURAL_DESIGN.md"; then
    echo ""
    echo "⚠️  REMINDER — Module file(s) changed but IH35_ARCHITECTURAL_DESIGN.md was not."
    echo ""
    echo "If this commit ADDS, REMOVES, or RENAMES a sub-nav tab, you MUST"
    echo "update docs/specs/IH35_ARCHITECTURAL_DESIGN.md in the same commit."
    echo ""
    echo "If this commit only modifies INSIDE a tab without changing tab"
    echo "count or names, no design update needed — proceed."
    echo ""
    echo "To bypass this reminder when no tab change applies:"
    echo "  git commit --no-verify"
    echo ""
  fi
fi

# MODULE_COMPLETION_AUTOGEN (HARD — Cursor thrash class 2026-07-29)
#
# docs/module-completion/*.json is the source of truth. apps/frontend/src/generated/
# module-completion.ts is DERIVED and gitignored (same pattern as the .md scoreboards) so
# parallel Cursor PRs stop conflicting on a committed generated file. Regenerate locally for
# typecheck; frontend package.json typecheck/build/dev also generate before tsc/vite.
# CI verify-module-completion-ui-in-sync regenerates then asserts FIRST_14.
if echo "$CHANGED_FILES" | grep -qE '^docs/module-completion/[^/]+\.json$'; then
  if ! command -v node >/dev/null 2>&1; then
    echo "COMMIT BLOCKED: node required to regenerate module-completion.ts after manifest edit"
    exit 1
  fi
  echo "MODULE_COMPLETION_AUTOGEN: regenerating apps/frontend/src/generated/module-completion.ts (gitignored)"
  node scripts/generate-module-completion-data.mjs || exit 1
  node scripts/generate-module-completion-data.mjs --check || exit 1
fi

# TYPECHECK_SKIP_DOCS_ONLY (HARD — worktree hook 2026-08-27)
# Fresh git worktrees often have no node_modules/.bin/tsc. `npm run typecheck` then exits 127
# and blocks docs/bus GO packets for 20–30 minutes. CI still typechecks. Skip only when the
# staged set has no apps/ or db/migrations/ paths. Code commits still require a local tsc.
STAGED_CODE=$(echo "$CHANGED_FILES" | grep -E '^(apps/|db/migrations/)' || true)
if [ -n "$STAGED_CODE" ]; then
  if [ ! -x node_modules/.bin/tsc ]; then
    echo "COMMIT BLOCKED: apps/ or db/migrations/ staged but node_modules/.bin/tsc is missing."
    echo "Run npm install in this worktree (do not --no-verify a code commit)."
    exit 1
  fi
  if command -v npm >/dev/null 2>&1; then
    npm run typecheck --if-present
  fi
else
  echo "pre-commit: TYPECHECK_SKIP_DOCS_ONLY — no apps/db staged; CI still typechecks"
fi
