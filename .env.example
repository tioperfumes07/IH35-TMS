DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Sentry — Observability
# Production DSN (server-side): https://sentry.io/organizations/ih-35-tms/projects/ih35-tms-prod/
SENTRY_DSN=your-prod-dsn-here
# Frontend DSN (exposed to Vite build — must be the same prod DSN)
VITE_SENTRY_DSN=your-prod-dsn-here
SENTRY_ORG_SLUG=ih-35-tms
SENTRY_PROJECT_SLUG=ih35-tms-prod
# Auth token for source-map uploads in CI (store as GitHub secret SENTRY_AUTH_TOKEN)
# SENTRY_AUTH_TOKEN=sntryu_...

# G4-DEPLOY (0243-g4 / ACCT-R-04): fixed unit for ci:boot-aggregate-smoke (preDeploy on Render).
# When both are set, the smoke skips "newest live TRANSP unit" discovery. See docs/testing/boot-aggregate-smoke-env.md.
# IH35_SMOKE_UNIT_ID=
# IH35_SMOKE_OPERATING_COMPANY_ID=
# Set true in production so preDeploy fails closed if either fixed UUID is missing.
# IH35_SMOKE_REQUIRE_FIXED_UNIT=false

# E1-SMOKE-SERVICE-TOKEN-AUTH: shared secret for service-to-service / cron HTTP calls
# Used by: GET /api/v1/internal/smoke-probe, GET /api/v1/internal/perf-metrics (alternative auth)
# Generate with: openssl rand -hex 32
# Store as GitHub secret SERVICE_TOKEN_SECRET
# SERVICE_TOKEN_SECRET=
