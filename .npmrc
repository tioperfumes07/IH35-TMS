# ROUND 443.232 — chromedriver is a transitive of unused @axe-core/cli (a11y walks
# use Playwright + axe-core, never the chromedriver binary). Postinstall downloads
# ChromeDriver 152 from Google CDN and ECONNRESETs flake CI (typescript-strict-null).
# Skip the binary; package install still succeeds. Override locally with
# CHROMEDRIVER_SKIP_DOWNLOAD=false only if you intentionally run @axe-core/cli.
chromedriver_skip_download=true
