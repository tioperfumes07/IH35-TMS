<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Certificate of Insurance request</title>
  </head>
  <body style="font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial; color: #1f2937;">
    <p>Hello,</p>
    <p><%= it.companyName %> is requesting a Certificate of Insurance for <strong><%= it.targetLabel %></strong>.</p>
    <% if (it.notes) { %>
    <p><%= it.notes %></p>
    <% } %>
    <p style="font-size:13px;color:#6b7280;">Reference: <%= it.requestId %></p>
  </body>
</html>
